//@version=6
// ============================================================================
// WAVE FLOOR — ATR ZigZag 피벗 검출 (트레이딩뷰 대조용)
//
// server/indicators/pivot.js 의 findPivots() 를 그대로 포팅한 것이다.
// 목적은 하나 — 우리 엔진이 찍는 피벗이 차트에서 사람이 찍을 자리와 같은지
// 눈으로 확인하는 것. 로직을 "개선"하지 말고 JS와 1:1로 유지해야 대조가 된다.
//
// 이식할 때 반드시 지킨 것:
//   ① 되돌림 검사를 극값 갱신보다 **먼저** 한다.
//      순서를 뒤집으면 상승 추세에서 매 봉 extIdx가 현재 봉으로 갱신돼
//      되돌림 조건이 영영 성립하지 않는다 (JS에서 실제로 겪은 버그다).
//   ② extIdx < bar_index 조건.
//      변동폭 큰 캔들 하나에서 고점·저점이 동시에 확정되면 두 피벗이 같은 봉에
//      찍혀 시간 순서가 무너진다.
//   ③ 시작값은 종가. dir=0 으로 출발해 상승 추적처럼 동작한다.
//
// 사용법:
//   1) 차트 봉을 맞추고 아래 표대로 ATR 배수를 설정한다
//        15m 3.5 / 30m 3.2 / 1h 3.0 / 4h 2.8 / 1d 2.5 / 1w 2.2
//   2) 우측 표의 피벗 시각·가격을 엔진 출력과 비교한다
//        node tools/dump-pivots.js BTCUSDT 1d
// ============================================================================

indicator("WAVE FLOOR — ATR ZigZag 피벗", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 50)

// ── 입력 ────────────────────────────────────────────────────────────────────
grpA   = "검출 파라미터"
atrLen = input.int(14, "ATR 기간", minval = 2, group = grpA)
k      = input.float(2.5, "ATR 배수 (PIVOT_K)", minval = 0.5, step = 0.1, group = grpA,
     tooltip = "엔진과 같은 값을 넣어야 대조가 됩니다.\n15m 3.5 / 30m 3.2 / 1h 3.0 / 4h 2.8 / 1d 2.5 / 1w 2.2")

grpB     = "표시"
showZig  = input.bool(true,  "지그재그 선", group = grpB)
showLbl  = input.bool(true,  "피벗 가격 라벨", group = grpB)
showTent = input.bool(true,  "미확정(진행 중) 피벗", group = grpB)
showTbl  = input.bool(true,  "대조표", group = grpB)
tblN     = input.int(12, "표에 표시할 피벗 수", minval = 3, maxval = 20, group = grpB)

colH = input.color(color.new(#f85149, 0), "고점", group = grpB, inline = "c")
colL = input.color(color.new(#3fb950, 0), "저점", group = grpB, inline = "c")
colZ = input.color(color.new(#c8c8d8, 55), "지그재그", group = grpB, inline = "c")

// ── ATR (Wilder) ───────────────────────────────────────────────────────────
// ta.atr 은 RMA 기반이라 JS 쪽 Wilder 평활과 같다.
atrV = ta.atr(atrLen)

// ── 상태 ───────────────────────────────────────────────────────────────────
var int   dir      = 0    //  1 = 상승 추적, -1 = 하락 추적, 0 = 시작
var float extPrice = na   // 추적 중인 극값
var int   extIdx   = na   // 그 극값이 있는 봉
var int   extTime  = na

var int   lastIdx   = na  // 직전 확정 피벗 (지그재그 연결용)
var float lastPrice = na

// 대조표용 최근 피벗 버퍼
var array<float> tPrice = array.new_float()
var array<int>   tTime  = array.new_int()
var array<bool>  tIsH   = array.new_bool()

// 미확정 피벗 표시는 매 봉 갱신되므로 지우고 다시 그린다
var label tentLbl = na
var line  tentLn  = na

// ── 확정 피벗 하나를 기록·작도 ──────────────────────────────────────────────
recordPivot(int pIdx, float pPrice, int pTime, bool isHigh) =>
    if showZig and not na(lastIdx)
        line.new(lastIdx, lastPrice, pIdx, pPrice, xloc = xloc.bar_index,
             color = colZ, width = 1)
    if showLbl
        label.new(pIdx, pPrice,
             text  = str.tostring(pPrice, format.mintick),
             xloc  = xloc.bar_index,
             style = isHigh ? label.style_label_down : label.style_label_up,
             color = color.new(isHigh ? colH : colL, 82),
             textcolor = isHigh ? colH : colL,
             size  = size.tiny)
    array.push(tPrice, pPrice)
    array.push(tTime,  pTime)
    array.push(tIsH,   isHigh)
    if array.size(tPrice) > 40
        array.shift(tPrice), array.shift(tTime), array.shift(tIsH)
    lastIdx   := pIdx
    lastPrice := pPrice

// ── 메인 루프 (바 단위) ────────────────────────────────────────────────────
// JS의 for 루프 한 회차가 Pine의 한 봉에 대응한다.
if not na(atrV)
    if na(extPrice)
        // JS: extIdx = period; extPrice = candles[period].c
        extPrice := close
        extIdx   := bar_index
        extTime  := time
        dir      := 0
    else
        th = k * atrV

        if dir >= 0
            // 되돌림 검사가 먼저 — 극값 갱신보다 앞서야 한다
            if extIdx < bar_index and extPrice - low >= th
                recordPivot(extIdx, extPrice, extTime, true)
                dir      := -1
                extPrice := low
                extIdx   := bar_index
                extTime  := time
            else if high >= extPrice
                extPrice := high
                extIdx   := bar_index
                extTime  := time
        else
            if extIdx < bar_index and high - extPrice >= th
                recordPivot(extIdx, extPrice, extTime, false)
                dir      := 1
                extPrice := high
                extIdx   := bar_index
                extTime  := time
            else if low <= extPrice
                extPrice := low
                extIdx   := bar_index
                extTime  := time

// ── 미확정(진행 중) 피벗 ───────────────────────────────────────────────────
// 엔진도 시간축당 딱 하나를 잠정 피벗으로 들고 있다. 하모닉 D 자리에만 허용된다.
if barstate.islast and showTent and not na(extPrice) and extIdx != lastIdx
    label.delete(tentLbl)
    line.delete(tentLn)
    bool isH = dir >= 0
    if showZig and not na(lastIdx)
        tentLn := line.new(lastIdx, lastPrice, extIdx, extPrice, xloc = xloc.bar_index,
             color = color.new(colZ, 40), width = 1, style = line.style_dashed)
    tentLbl := label.new(extIdx, extPrice,
         text  = str.tostring(extPrice, format.mintick) + " (진행중)",
         xloc  = xloc.bar_index,
         style = isH ? label.style_label_down : label.style_label_up,
         color = color.new(color.gray, 82),
         textcolor = color.gray,
         size  = size.tiny)

// ── 대조표 ─────────────────────────────────────────────────────────────────
var table tbl = table.new(position.top_right, 4, 22,
     border_width = 1, border_color = color.new(color.gray, 70),
     frame_width = 1, frame_color = color.new(color.gray, 50))

if barstate.islast and showTbl
    table.clear(tbl, 0, 0, 3, 21)
    table.cell(tbl, 0, 0, "시각",  text_color = color.silver, text_size = size.tiny, bgcolor = color.new(color.black, 20))
    table.cell(tbl, 1, 0, "종류",  text_color = color.silver, text_size = size.tiny, bgcolor = color.new(color.black, 20))
    table.cell(tbl, 2, 0, "가격",  text_color = color.silver, text_size = size.tiny, bgcolor = color.new(color.black, 20))
    table.cell(tbl, 3, 0, "직전대비", text_color = color.silver, text_size = size.tiny, bgcolor = color.new(color.black, 20))

    int n     = array.size(tPrice)
    int start = math.max(0, n - tblN)
    int row   = 1
    for i = start to n - 1
        if row > 20
            break
        float p  = array.get(tPrice, i)
        int   tt = array.get(tTime,  i)
        bool  ih = array.get(tIsH,   i)
        string chg = "-"
        if i > 0
            float prev = array.get(tPrice, i - 1)
            float pc   = (p - prev) / prev * 100
            chg := (pc >= 0 ? "+" : "") + str.tostring(pc, "#.##") + "%"
        table.cell(tbl, 0, row, str.format_time(tt, "MM-dd HH:mm", syminfo.timezone),
             text_color = color.silver, text_size = size.tiny)
        table.cell(tbl, 1, row, ih ? "고점" : "저점",
             text_color = ih ? colH : colL, text_size = size.tiny)
        table.cell(tbl, 2, row, str.tostring(p, format.mintick),
             text_color = color.white, text_size = size.tiny)
        table.cell(tbl, 3, row, chg,
             text_color = color.new(color.silver, 30), text_size = size.tiny)
        row += 1

    // 현재 설정 요약 — 엔진과 파라미터가 같은지 한눈에 확인
    table.cell(tbl, 0, row, "설정", text_color = color.orange, text_size = size.tiny)
    table.cell(tbl, 1, row, "ATR" + str.tostring(atrLen), text_color = color.orange, text_size = size.tiny)
    table.cell(tbl, 2, row, "×" + str.tostring(k, "#.#"), text_color = color.orange, text_size = size.tiny)
    table.cell(tbl, 3, row, "확정 " + str.tostring(array.size(tPrice)), text_color = color.orange, text_size = size.tiny)

// 임계값을 눈으로 보고 싶을 때 — 현재 ATR × k 가 가격의 몇 %인지
plotchar(k * atrV / close * 100, "임계값(%)", "", location.top, color.new(color.gray, 100))
